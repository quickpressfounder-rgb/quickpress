# ---- QuickPress frontend environment (development / production) ----
# FastAPI backend base URL. Set to http://localhost:8000 for local development.
VITE_API_BASE_URL=https://quickpress-api-production.up.railway.app
VITE_SOCKET_URL=https://quickpress-api-production.up.railway.app
# Request timeout in milliseconds (default 15000).
VITE_API_TIMEOUT_MS=15000
# development | staging | production
VITE_APP_ENV=development

# ---- Firebase Authentication (never hardcode these in source) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Apple Sign In is prepared but must stay "false" on Android builds.
VITE_APPLE_SIGN_IN_ENABLED=false

# ---- Google Maps (browser rendering key only; server key lives in FastAPI) ----
VITE_GOOGLE_MAPS_API_KEY=

# ---- OneSignal Mobile & Web Push (Client App ID) ----
VITE_ONESIGNAL_APP_ID=

# ---- Razorpay Client Checkout Key (rzp_test_... or rzp_live_...; never key_secret) ----
VITE_RAZORPAY_KEY_ID=

# ---- Supabase Public Client Config ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

