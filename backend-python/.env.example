# ---- QuickPress FastAPI backend environment ----
# Variable NAMES only. Never commit real secret values.

# development | staging | production
APP_ENV=development
API_PREFIX=/api

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=https://with.quickpress.com,https://www.with.quickpress.com,https://withquickpress.com,https://www.withquickpress.com,https://appk-mu.vercel.app,https://quickpress-partner.vercel.app,https://quickpress-rider.vercel.app,https://quickpress-admin.vercel.app,https://quickpress-website.vercel.app,https://www.quickpress.online,https://quickpress.online

# ---- Supabase / PostgreSQL Database ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- JWT ----
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- Firebase Admin (service account) ----
FIREBASE_PROJECT_ID=quickpress-b1e19
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively provide the whole service account:
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google Maps Platform ----
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=
DELIVERY_RADIUS_KM=8

# ---- OTP ----
OTP_TTL_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# ---- SMS & OTP Gateways (India & International) ----
# Option A: Fast2SMS (Recommended for India - fast & low-cost OTP route)
FAST2SMS_API_KEY=
# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ---- Distributed Rate Limiting (Redis) ----
# Redis connection URL for cluster rate-limiting and anti-DDoS: e.g. rediss://default:pwd@host:port
REDIS_URL=

# ---- Sentry Error & Threat Monitoring ----
# Sentry DSN for real-time exception and threat alerts: e.g. https://xyz@sentry.io/123456
SENTRY_DSN=

# ---- Email & SMTP Gateway (Gmail / Custom SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=official.quickpress@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=QuickPress

# ---- Resend Transactional Email (Optional Fallback) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=QuickPress Security <onboarding@resend.dev>

